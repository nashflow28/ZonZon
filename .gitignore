# ─── Secrets / env ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
**/.env
!**/.env.example

# ─── Node ───────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log
yarn-error.log
*.log

# ─── Builds / artefacts ─────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
out-tsc/
coverage/
**/coverage/
.angular/
**/.angular/

# ─── Flutter / Dart ─────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/ios/Flutter/.last_build_id
mobile_app/android/app/debug/
mobile_app/android/app/profile/
mobile_app/android/app/release/
**/.gradle/
**/local.properties

# ─── Uploads runtime / médias générés ───────────────────────────────
backend/uploads/
!backend/uploads/.gitkeep

# ─── Outils internes / artefacts d'analyse ──────────────────────────
.playwright-mcp/
audit/

# ─── Dumps / crashs ─────────────────────────────────────────────────
*.stackdump
*.dmp

# ─── IDE / OS ───────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml
*.swp
.DS_Store
Thumbs.db

# ─── Fichiers binaires lourds qu'on ne push jamais ──────────────────
*.apk
*.aab
*.ipa
*.exe
*.dll
*.so
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

firebase-adminsdk.json
.claude/

# Artefacts d'outillage Codex (captures, pieces jointes) — pas du code source
.codex/
.codex-remote-attachments/

# Secrets de signature Android (keystore + mots de passe) — jamais versionnes
key.properties
mobile_app/android/key.properties

# Archive ZIP du kit de marque : duplique intégralement brand/zonzon-logo-kit/
# (18 Mo pour le même contenu, non diffable et incompressible par git).
# Le dossier, lui, EST versionné — c'est la source de vérité.
# Régénérable via brand/zonzon-logo-kit/tools/build_logo_kit.py
brand/*.zip
