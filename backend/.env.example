NODE_ENV=development
PORT=3050

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=zonzon_db

JWT_SECRET=<générer avec: openssl rand -base64 48>

FRONTEND_URLS=http://localhost:4200,http://localhost:8080

# OpenRouteService — clé API requise (free tier : 2000 req/jour). Crée la sur https://openrouteservice.org
# Si absent, le serveur retombe sur Haversine × 1.3 (suffisant pour dev local).
ORS_API_KEY=
COMMISSION_RATE=0.35
UPLOAD_DIR=uploads
IDENTITY_UPLOAD_DIR=private_uploads/identity
IDENTITY_STORAGE_ENDPOINT=
IDENTITY_STORAGE_BUCKET=
IDENTITY_STORAGE_ACCESS_KEY_ID=
IDENTITY_STORAGE_SECRET_ACCESS_KEY=
IDENTITY_STORAGE_REGION=auto
IDENTITY_STORAGE_FORCE_PATH_STYLE=false
NOTIFY_RADIUS_KM=5
# Validation du numéro à l'inscription via WhatsApp Cloud API (Meta).
# Laisser désactivé jusqu'à ce que le numéro et le template soient approuvés.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=zonzon_verification_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_OTP_RESEND_SECONDS=60
